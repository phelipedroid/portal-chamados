<ul class="navbar-nav
           align-items-lg-center
           gap-lg-1">

    @if (User.Identity?.IsAuthenticated == true)
    {
        var nomeExibido =
            User.FindFirst(
                PortalSanMarco.Services.PortalUserClaimsPrincipalFactory
                    .PrimeiroNomeClaim)?.Value
            ?? User.Identity.Name?.Split('@')[0]
            ?? "Usuário";

        <li class="nav-item dropdown">
            <button type="button"
                    id="botao-notificacoes"
                    class="nav-link btn btn-link text-dark position-relative"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="Abrir notificações">
                <span aria-hidden="true" class="fs-5">🔔</span>
                <span id="contador-notificacoes"
                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                    0
                </span>
            </button>

            <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0"
                 aria-labelledby="botao-notificacoes"
                 style="width: min(380px, 90vw);">
                <div class="px-3 py-2 border-bottom fw-semibold">
                    Notificações
                </div>

                <div id="lista-notificacoes"
                     class="list-group list-group-flush">
                    <div class="px-3 py-4 text-center text-muted small">
                        Carregando notificações...
                    </div>
                </div>
            </div>
        </li>

        <li class="nav-item">
            <span class="nav-link text-muted">
                Olá,
                <strong>
                    @nomeExibido
                </strong>
            </span>
        </li>

        <li class="nav-item">
            <a asp-controller="Conta"
               asp-action="TrocarSenha"
               class="nav-link text-dark">
                Alterar senha
            </a>
        </li>

        <li class="nav-item">
            <form asp-controller="Conta"
                  asp-action="Sair"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="btn
                               btn-link
                               nav-link
                               text-danger
                               border-0">
                    Sair
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-controller="Conta"
               asp-action="Entrar"
               class="nav-link text-dark">
                Entrar
            </a>
        </li>
    }
</ul>
