<div class="border rounded-3 bg-light p-3 mb-4"
     data-password-checklist
     data-password-input="NovaSenha"
     data-confirmation-input="ConfirmacaoSenha">

    <div class="small fw-semibold mb-2">
        Sua nova senha precisa ter:
    </div>

    <ul class="list-unstyled small mb-0 d-grid gap-1">
        <li class="text-muted" data-password-rule="length">
            <span aria-hidden="true">○</span>
            Pelo menos 8 caracteres
        </li>
        <li class="text-muted" data-password-rule="uppercase">
            <span aria-hidden="true">○</span>
            Uma letra maiúscula
        </li>
        <li class="text-muted" data-password-rule="lowercase">
            <span aria-hidden="true">○</span>
            Uma letra minúscula
        </li>
        <li class="text-muted" data-password-rule="number">
            <span aria-hidden="true">○</span>
            Um número
        </li>
        <li class="text-muted" data-password-rule="special">
            <span aria-hidden="true">○</span>
            Um caractere especial
        </li>
        <li class="text-muted" data-password-rule="unique">
            <span aria-hidden="true">○</span>
            Pelo menos 4 caracteres diferentes
        </li>
        <li class="text-muted" data-password-rule="confirmation">
            <span aria-hidden="true">○</span>
            Confirmação igual à nova senha
        </li>
    </ul>
</div>
