@model IEnumerable<PortalSanMarco.ViewModels.SetorListaViewModel>

@{
    ViewData["Title"] = "Setores";
}

<div class="d-flex
            justify-content-between
            align-items-center
            flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Setores</h1>
        <p class="text-muted mb-0">
            Gerencie os setores disponíveis no portal
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-success">
        Novo setor
    </a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Setor</th>
                    <th>Funcionários</th>
                    <th>Chamados</th>
                    <th>Situação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted py-5">
                            Nenhum setor cadastrado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var setor in Model)
                    {
                        <tr class="@(!setor.Ativo
                                      ? "table-secondary"
                                      : "")">
                            <td>
                                <strong>@setor.Nome</strong>
                            </td>
                            <td>@setor.TotalFuncionarios</td>
                            <td>@setor.TotalChamados</td>
                            <td>
                                @if (setor.Ativo)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativo
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex
                                            justify-content-end
                                            flex-wrap gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@setor.Id"
                                       class="btn btn-sm
                                              btn-outline-success">
                                        Editar
                                    </a>

                                    <form asp-action="AlternarStatus"
                                          asp-route-id="@setor.Id"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm
                                                       btn-outline-secondary">
                                            @(setor.Ativo
                                                ? "Desativar"
                                                : "Ativar")
                                        </button>
                                    </form>

                                    @if (setor.PodeExcluir)
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@setor.Id"
                                              method="post"
                                              data-confirm="Excluir este setor definitivamente?">
                                            <button type="submit"
                                                    class="btn btn-sm
                                                           btn-outline-danger">
                                                Excluir
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-info mt-4">
    Setores vinculados a funcionários ou chamados não podem ser excluídos.
    Desative-os para impedir novos cadastros sem perder o histórico.
</div>
