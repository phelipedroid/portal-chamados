@model IReadOnlyCollection<PortalSanMarco.ViewModels.CadastroPendenteListaViewModel>

@{
    ViewData["Title"] = "Cadastros pendentes";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Cadastros pendentes</h1>
        <p class="text-muted mb-0">Solicitações feitas pelos próprios funcionários</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Ver todos os usuários</a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="alert alert-info">
    A solicitação não envia e-mail. Ao aprovar, somente o funcionário recebe uma única confirmação.
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Funcionário</th>
                    <th>Unidade</th>
                    <th>Setor</th>
                    <th>Solicitado em</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            Nenhum cadastro aguardando aprovação.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cadastro in Model)
                    {
                        <tr>
                            <td>
                                <strong>@cadastro.NomeCompleto</strong>
                                <div class="small text-muted">@cadastro.Email</div>
                                @if (!string.IsNullOrWhiteSpace(cadastro.Cargo))
                                {
                                    <div class="small text-muted">@cadastro.Cargo</div>
                                }
                            </td>
                            <td>@cadastro.Unidade</td>
                            <td>@cadastro.Setor</td>
                            <td>@cadastro.SolicitadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a asp-action="RevisarCadastro"
                                       asp-route-id="@cadastro.UsuarioId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Revisar
                                    </a>
                                    <form asp-action="AprovarCadastro" method="post">
                                        <input type="hidden" name="id" value="@cadastro.UsuarioId" />
                                        <button type="submit" class="btn btn-sm btn-success">Aprovar</button>
                                    </form>
                                    <form asp-action="RejeitarCadastro"
                                          method="post"
                                          data-confirm="Rejeitar e remover esta solicitação? Nenhum e-mail será enviado.">
                                        <input type="hidden" name="id" value="@cadastro.UsuarioId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Rejeitar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
