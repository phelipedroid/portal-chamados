@model PortalSanMarco.ViewModels.RevisarCadastroPendenteViewModel

@{
    ViewData["Title"] = "Revisar cadastro";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Revisar cadastro</h1>
        <p class="text-muted mb-0">Confira os dados antes de aprovar o acesso</p>
    </div>
    <a asp-action="Pendentes" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="RevisarCadastro" method="post">
            <input asp-for="UsuarioId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="NomeCompleto" class="form-label fw-semibold"></label>
                    <input asp-for="NomeCompleto" class="form-control" />
                    <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnidadeId" class="form-label fw-semibold"></label>
                    <select asp-for="UnidadeId" asp-items="ViewBag.Unidades" class="form-select"></select>
                    <span asp-validation-for="UnidadeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SetorId" class="form-label fw-semibold"></label>
                    <select asp-for="SetorId" asp-items="ViewBag.Setores" class="form-select"></select>
                    <span asp-validation-for="SetorId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Cargo" class="form-label fw-semibold"></label>
                    <input asp-for="Cargo" class="form-control" />
                    <span asp-validation-for="Cargo" class="text-danger small"></span>
                </div>
            </div>

            <div class="alert alert-light border mt-4 mb-0">
                O perfil será <strong>Funcionário</strong>. Salvar a revisão não aprova o acesso e não envia e-mail.
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Pendentes" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">Salvar revisão</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
