@{
    Layout = null;
    ViewData["Title"] = "Solicitação recebida";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solicitação recebida - Portal San Marco</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { min-height: 100vh; background: linear-gradient(135deg, #f4f7f5, #e8f3ed); }
        .result-card { max-width: 540px; border: 0; border-radius: 18px; box-shadow: 0 22px 55px rgba(10,55,35,.12); }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-4">
    <main class="card result-card w-100 text-center">
        <div class="card-body p-4 p-md-5">
            <div class="display-5 mb-3" aria-hidden="true">✓</div>
            <h1 class="h3 mb-3">Solicitação recebida</h1>
            <p class="text-muted">
                Seu cadastro foi enviado para análise da equipe de TI. Você receberá um único e-mail quando o acesso for aprovado.
            </p>
            <a asp-controller="Conta" asp-action="Entrar" class="btn btn-success mt-3">
                Voltar para o login
            </a>
        </div>
    </main>
</body>
</html>
